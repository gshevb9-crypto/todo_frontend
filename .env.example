# ==============================================================================
# VERCEL FRONTEND CONFIGURATION
# ==============================================================================
# Set this in Vercel Dashboard -> Project Settings -> Environment Variables.
# Point to your deployed backend API URL (e.g., https://api.yourdomain.com or Blitz.cloud URL).
#
# IMPORTANT:
# - Do NOT include a trailing slash.
# - If your backend routes are under /api, VITE_API_BASE_URL can be either
#   'https://api.yourdomain.com' or 'https://api.yourdomain.com/api'.
#   axiosInstance automatically normalizes both to prevent duplication.
# - For local development against Docker Compose or local dotnet run:
#   VITE_API_BASE_URL=http://localhost:8080
#
VITE_API_BASE_URL=https://api.yourdomain.com
